[
    {
        "id": "flow1",
        "type": "tab",
        "label": "MQTT to ThingsBoard",
        "disabled": false,
        "info": "Basic flow that subscribes to MQTT and forwards to ThingsBoard"
    },
    {
        "id": "mqtt-in",
        "type": "mqtt in",
        "z": "flow1",
        "name": "MQTT Subscribe",
        "topic": "sensor/data",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt-broker",
        "x": 130,
        "y": 100,
        "wires": [["parse-json"]]
    },
    {
        "id": "parse-json",
        "type": "json",
        "z": "flow1",
        "name": "Parse JSON",
        "property": "payload",
        "action": "",
        "x": 310,
        "y": 100,
        "wires": [["extract-temp", "debug1"]]
    },
    {
        "id": "extract-temp",
        "type": "function",
        "z": "flow1",
        "name": "Extract Temperature",
        "func": "msg.payload = msg.payload.temperature;\nreturn msg;",
        "outputs": 1,
        "x": 520,
        "y": 100,
        "wires": [["temp-gauge"]]
    },
    {
        "id": "temp-gauge",
        "type": "ui_gauge",
        "z": "flow1",
        "name": "Temperature Gauge",
        "group": "dashboard-group",
        "order": 1,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "min": 0,
        "max": "50",
        "x": 740,
        "y": 100,
        "wires": []
    },
    {
        "id": "debug1",
        "type": "debug",
        "z": "flow1",
        "name": "Debug Output",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 520,
        "y": 160,
        "wires": []
    },
    {
        "id": "mqtt-broker",
        "type": "mqtt-broker",
        "name": "Local MQTT Broker",
        "broker": "localhost",
        "port": "1883",
        "clientid": "",
        "usetls": false,
        "compatmode": false,
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "willTopic": "",
        "willQos": "0",
        "willPayload": ""
    },
    {
        "id": "dashboard-group",
        "type": "ui_group",
        "name": "Sensor Monitoring",
        "tab": "dashboard-tab",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "dashboard-tab",
        "type": "ui_tab",
        "name": "IoT Dashboard",
        "icon": "dashboard",
        "order": 1,
        "disabled": false,
        "hidden": false
    }
]
